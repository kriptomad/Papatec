// ============================================================================
// PapaTec ERP - Schema Prisma (PostgreSQL)
// Licenciado por Filitech
// Contrato de dados alinhado ao frontend (Budget = Orçamento, ServiceOrder = O.S.)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  TECHNICIAN
  RECEPTIONIST
}

enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED_TO_OS
}

enum OsStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
}

enum PartStatus {
  ACTIVE
  INACTIVE
}

// Classificação de pessoa (Cliente/Fornecedor/Funcionário): Física ou Jurídica
enum PartyType {
  PF
  PJ
}

// Tipo do produto (PDF p.3): Novo / Usado / Digital
enum ProductType {
  NEW
  USED
  DIGITAL
}

enum ItemType {
  PART
  SERVICE
  LABOR
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum ExpenseCategory {
  RENT
  ENERGY
  SALARIES
  MATERIALS
  MARKETING
  TAXES
  OTHER
}

// Tipo do evento de calendário
enum CalendarEventType {
  APPOINTMENT      // Agendamento técnico (ServiceVisit aprovado)
  HOLIDAY          // Feriado
  SPECIAL_DATE     // Data especial (aniversário, promoção...)
  LUNCH_BREAK      // Horário de almoço
  BUSINESS_HOURS   // Expediente (abertura/fechamento)
  CUSTOM           // Evento personalizado
}

// Status de aprovação do agendamento pelo técnico
enum AppointmentStatus {
  PENDING    // Aguardando aprovação do técnico
  APPROVED   // Aprovado pelo técnico -> vai pro calendário
  REJECTED   // Recusado pelo técnico
  CANCELLED  // Cancelado
}

// ---------------------------------------------------------------------------
// Usuários e acesso
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  // Cadastro de Funcionário/Parceiro (PDF p.4) - código único de exibição
  code         String?  @unique
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(TECHNICIAN)
  active       Boolean  @default(true)
  avatar       String?
  // Endereço completo
  street       String?
  number       String?
  complement   String?
  district     String?
  zip          String?
  city         String?
  state        String?
  // Documentos (Físico: RG/CPF - Jurídico: CNPJ/IE/IM)
  cpf          String?  @unique
  rg           String?
  cnpj         String?
  ie           String?
  im           String?
  // Contato
  phone        String?
  ramal        String?
  site         String?
  notes        String?
  commissionPercent Float? @map("commission_percent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  budgets          Budget[]
  serviceOrders    ServiceOrder[]     @relation("OrderCreator")
  technicianOrders ServiceOrder[]     @relation("OrderTechnician")
  movements        StockMovement[]
  osMovements      OsMovement[]
  purchases        Purchase[]
  clientsAsResponsible Client[]       @relation("ClientResponsible")
  visits          ServiceVisit[] @relation("VisitTechnician")
  calendarEventsAsTech  CalendarEvent[] @relation("CalendarEventTechnician")
  calendarEventsCreated CalendarEvent[] @relation("CalendarEventCreator")
  sales               Sale[]
  saleReturns         SaleReturn[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(uuid())
  // Código único de exibição (CLI-0001) - PDF p.1
  code      String?  @unique
  // Classificação Pessoa Física / Jurídica + status ativo (PDF p.1)
  type      PartyType @default(PF)
  active    Boolean  @default(true)
  name      String
  phone     String
  ramal     String?
  email     String?
  site      String?
  // Endereço legado (texto único) - mantido por compatibilidade;
  // o endereço estruturado abaixo é o que o PDF pede
  address   String?
  street    String?
  number    String?
  complement String?
  district  String?
  zip       String?
  city      String?
  state     String?
  cpf       String?  @unique
  rg        String?
  cnpj      String?  @unique
  ie        String?
  im        String?
  // Funcionário responsável pelo atendimento
  responsibleId String?  @map("responsible_id")
  responsible   User?    @relation("ClientResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  budgets       Budget[]
  serviceOrders ServiceOrder[]
  addresses     ClientAddress[]
  equipments    Equipment[]
  sales         Sale[]

  @@index([name])
  @@map("clients")
}

// Briefing D3/B.2.1: um cliente pode ter VÁRIOS endereços
// (usados no orçamento/O.S. — "Endereço Para Serviço" com dropdown)
model ClientAddress {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String?
  street     String
  number     String?
  complement String?
  district   String?
  zip        String?
  city       String?
  state      String?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("client_addresses")
}

// Briefing D1: equipamento com ID único atrelado ao cliente
// (reutilizado no orçamento/O.S. no lugar do JSON avulso)
model Equipment {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  brand        String?
  model        String?
  serialNumber String?  @map("serial_number")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("equipment")
}

// ---------------------------------------------------------------------------
// Orçamentos (Budget) - eram "Quote" no modelo inicial
// ---------------------------------------------------------------------------

model Budget {
  id         String       @id @default(uuid())
  clientId   String       @map("client_id")
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creatorId  String       @map("creator_id")
  creator    User         @relation(fields: [creatorId], references: [id])
  status     BudgetStatus @default(DRAFT)
  equipment  Json         @default("[]")
  defect     String
  laborHours Float        @default(0) @map("labor_hours")
  laborRate  Float        @default(0) @map("labor_rate")
  totalParts Float        @default(0) @map("total_parts")
  totalServices Float     @default(0) @map("total_services")
  totalLabor Float        @default(0) @map("total_labor")
  total      Float        @default(0)
  notes      String?
  validUntil DateTime?    @map("valid_until")
  // Briefing B.2: serviço local × externo + endereço do serviço (snapshot)
  serviceType    String  @default("LOCAL") @map("service_type")
  serviceAddress Json?   @map("service_address")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  items        BudgetItem[]
  attachments  BudgetAttachment[]
  serviceOrder ServiceOrder?

  @@index([clientId])
  @@index([status])
  @@map("budgets")
}

model BudgetItem {
  id        String   @id @default(uuid())
  budgetId  String   @map("budget_id")
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  partId    String?  @map("part_id")
  part      Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String
  qty       Int      @default(1)
  unitPrice Float    @map("unit_price")
  total     Float
  // Briefing B3: desconto por item (% ou R$), validado contra o limite do item
  discount     Float   @default(0)
  discountType String  @default("VALUE") @map("discount_type")
  type      ItemType @default(PART)
  // Briefing: comissão personalizada POR ITEM (venda de produto)
  commissionPercent Float  @default(0) @map("commission_percent")
  commissionValue   Float  @default(0) @map("commission_value")
  commissionType    String  @default("PERCENT") @map("commission_type")

  @@index([budgetId])
  @@map("budget_items")
}

model BudgetAttachment {
  id        String   @id @default(uuid())
  budgetId  String   @map("budget_id")
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  filePath  String   @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("budget_attachments")
}

// ---------------------------------------------------------------------------
// Ordens de Serviço (ServiceOrder) - eram "WorkOrder" no modelo inicial
// ---------------------------------------------------------------------------

model ServiceOrder {
  id           String    @id @default(uuid())
  osNumber     Int       @unique @default(autoincrement()) @map("os_number")
  budgetId     String?   @unique @map("budget_id")
  budget       Budget?   @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  clientId     String    @map("client_id")
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creatorId    String    @map("creator_id")
  creator      User      @relation("OrderCreator", fields: [creatorId], references: [id])
  technicianId String?   @map("technician_id")
  technician   User?     @relation("OrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  status       OsStatus  @default(OPEN)
  equipment    Json      @default("[]")
  defect       String
  diagnosis    String?
  solution     String?
  laborHours   Float     @default(0) @map("labor_hours")
  laborRate    Float     @default(0) @map("labor_rate")
  totalParts   Float     @default(0) @map("total_parts")
  totalServices Float    @default(0) @map("total_services")
  totalLabor   Float     @default(0) @map("total_labor")
  total        Float     @default(0)
  warrantyDays Int       @default(90) @map("warranty_days")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  deliveredAt  DateTime? @map("delivered_at")
  // Briefing B.2/C: serviço externo, endereço do serviço, fonte das horas
  // da mão de obra (MANUAL | VISITS) e checklist montado na criação
  serviceType    String  @default("LOCAL") @map("service_type")
  serviceAddress Json?   @map("service_address")
  // Vários endereços para o mesmo serviço externo (cliente pede residência +
  // escritório). O primeiro da lista é o endereço principal e também é
  // espelhado em `serviceAddress` (mantém impressão/visitas/relatórios
  // antigos funcionando sem alteração).
  serviceAddresses Json? @map("service_addresses")
  laborSource    String  @default("MANUAL") @map("labor_source")
  checklist      Json?
  // Agendamento externo: horário sugerido + aprovação do técnico
  scheduledAt         DateTime?         @map("scheduled_at")
  appointmentStatus   AppointmentStatus @default(PENDING) @map("appointment_status")
  // Comissão total da O.S. (somada dos itens)
  totalCommission     Float             @default(0) @map("total_commission")
  // Briefing O.S.: observações internas x externas (externa aparece impressa)
  internalNotes  String? @map("internal_notes")
  externalNotes  String? @map("external_notes")
  // Briefing O.S.: equipamento - acessórios, estado, senha, quem deixou
  accessories    String? @map("accessories")
  condition      String? @map("condition")
  devicePassword String? @map("device_password")
  droppedOffBy   String? @map("dropped_off_by")
  // Briefing: delivery - equipamento retirado/levado ao cliente c/ valor automático
  deliveryType   String  @default("NONE") @map("delivery_type")
  deliveryValue  Float   @default(0) @map("delivery_value")
  deliveryDone   Boolean @default(false) @map("delivery_done")
  // PDF p.6/7 - processo de fechamento de O.S.:
  // forma de pagamento combinada, contato com cliente (aprovação + desconto)
  // e "resumo p/ cliente" (gerar -> salvar -> imprimir)
  paymentMethod      String? @map("payment_method")
  clientApproved     Boolean? @map("client_approved")
  clientContactNotes String? @map("client_contact_notes")
  clientSummary      String? @map("client_summary")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items     OsItem[]
  movements OsMovement[]
  photos    OsPhoto[]
  visits    ServiceVisit[]

  @@index([clientId])
  @@index([status])
  @@index([technicianId])
  @@index([appointmentStatus])
  @@map("service_orders")
}

model OsItem {
  id        String   @id @default(uuid())
  osId      String   @map("os_id")
  os        ServiceOrder @relation(fields: [osId], references: [id], onDelete: Cascade)
  partId    String?  @map("part_id")
  part      Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String
  qty       Int      @default(1)
  unitPrice Float    @map("unit_price")
  total     Float
  // Briefing B3: desconto por item (% ou R$), validado contra o limite do item
  discount     Float   @default(0)
  discountType String  @default("VALUE") @map("discount_type")
  type      ItemType @default(PART)
  // Briefing: comissão personalizada POR ITEM (venda de produto)
  commissionPercent Float  @default(0) @map("commission_percent")
  commissionValue   Float  @default(0) @map("commission_value")
  commissionType    String  @default("PERCENT") @map("commission_type")

  @@index([osId])
  @@map("os_items")
}

model OsMovement {
  id         String    @id @default(uuid())
  osId       String    @map("os_id")
  os         ServiceOrder @relation(fields: [osId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  fromStatus OsStatus? @map("from_status")
  toStatus   OsStatus  @map("to_status")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([osId])
  @@map("os_movements")
}

model OsPhoto {
  id        String   @id @default(uuid())
  osId      String   @map("os_id")
  os        ServiceOrder @relation(fields: [osId], references: [id], onDelete: Cascade)
  filePath  String   @map("file_path")
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([osId])
  @@map("os_photos")
}

// Briefing B2.3/C1: visitas agendadas de serviço externo + registro de horas
// do técnico (entrada/saída, segunda ida, endereço por visita)
model ServiceVisit {
  id               String            @id @default(uuid())
  osId             String            @map("os_id")
  os               ServiceOrder      @relation(fields: [osId], references: [id], onDelete: Cascade)
  // Dia da visita (Briefing B2.3: várias visitas no mesmo dia, endereços distintos)
  date             DateTime          @db.Date
  // Horário agendado (13:30 residência, 14:30 escritório...)
  scheduledAt      DateTime?         @map("scheduled_at")
  // Duração prevista ("Tempo Serviço: 2h"). Define o fim do slot no calendário
  // e é usado na detecção de conflito do MESMO técnico.
  durationMinutes  Int?              @map("duration_minutes")
  // Status de aprovação pelo técnico
  appointmentStatus AppointmentStatus @default(PENDING) @map("appointment_status")
  // Snapshot do endereço desta visita
  address          Json?
  // Registro real de horas (Briefing C1): hora entrada/saída na casa do cliente
  arrival          DateTime?
  departure        DateTime?
  // Checkbox "Necessidade de segunda ida" (não obrigatório)
  needsSecondVisit Boolean           @default(false) @map("needs_second_visit")
  notes            String?
  techId           String?           @map("tech_id")
  tech             User?             @relation("VisitTechnician", fields: [techId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([osId])
  @@index([date])
  @@index([appointmentStatus])
  @@map("service_visits")
}

// ---------------------------------------------------------------------------
// Inventário (Part) - era "Inventory" no modelo inicial
// ---------------------------------------------------------------------------

model Part {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  category    String?
  unit        String     @default("UN")
  costPrice   Float      @default(0) @map("cost_price")
  salePrice   Float      @default(0) @map("sale_price")
  minStock    Int        @default(1) @map("min_stock")
  quantity    Int        @default(0)
  status      PartStatus @default(ACTIVE)
  // PDF p.3: Tipo (Novo/Usado/Digital), NCM e % de comissão específica
  productType ProductType? @map("product_type")
  ncm         String?
  commissionPercent Float? @map("commission_percent")
  // Briefing A (estoque): busca por fabricante/característica, limite de
  // desconto próprio do item e alerta de reposição opcional
  manufacturer      String?  @map("manufacturer")
  characteristics   String?  @map("characteristics")
  maxDiscountPercent Float?  @map("max_discount_percent")
  maxDiscountValue   Float?  @map("max_discount_value")
  alertEnabled      Boolean  @default(true) @map("alert_enabled")
  // Briefing: código de barra (SKU) além do código próprio
  barcode           String?  @unique @map("barcode")
  supplier    String?
  location    String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  budgetItems      BudgetItem[]
  osItems          OsItem[]
  movements        StockMovement[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  saleReturnItems  SaleReturnItem[]

  @@index([category])
  @@index([status])
  @@map("parts")
}

model StockMovement {
  id        String       @id @default(uuid())
  partId    String       @map("part_id")
  part      Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  type      MovementType
  qty       Int
  reason    String?
  // Briefing: histórico de entradas/saídas COM valores
  unitValue Float        @default(0) @map("unit_value")
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([partId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fornecedores (PDF p.2) - espelho do cadastro de Cliente
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid())
  // Código único de exibição (FOR-0001)
  code      String?  @unique
  type      PartyType @default(PF)
  active    Boolean  @default(true)
  name      String
  // Contato: responsável pelo contato
  contact   String?
  phone     String?
  ramal     String?
  email     String?
  site      String?
  // Endereço (Rua/Av., Número, Complemento, Bairro, CEP, Cidade, Estado)
  street    String?
  number    String?
  complement String?
  district  String?
  zip       String?
  city      String?
  state     String?
  // Documentos (Físico: RG/CPF - Jurídico: CNPJ/IE/IM)
  cpf       String?  @unique
  rg        String?
  cnpj      String?  @unique
  ie        String?
  im        String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]

  @@index([name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Entrada de Mercadoria / Compra (PDF p.5)
// Na criação: baixa automática de estoque (IN) + atualização do custo com
// frete, imposto e desconto rateados proporcionalmente ao valor dos itens.
// ---------------------------------------------------------------------------

model Purchase {
  id            String   @id @default(uuid())
  // Código único da compra (COM-0001)
  code          String?  @unique
  supplierId    String   @map("supplier_id")
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseDate  DateTime @default(now()) @map("purchase_date")
  itemsTotal    Float    @default(0) @map("items_total")
  freight       Float    @default(0)
  tax           Float    @default(0)
  // Desconto: valor digitado (R$ se VALUE, % se PERCENT)
  discountType  String   @default("VALUE") @map("discount_type")
  discount      Float    @default(0)
  total         Float    @default(0)
  paymentMethod String?  @map("payment_method")
  nfNumber      String?  @map("nf_number")
  nfTransport   String?  @map("nf_transport")
  notes         String?
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partId     String?  @map("part_id")
  part       Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  // Snapshot do item no momento da compra
  name       String
  code       String?
  qty        Int
  unitPrice  Float    @map("unit_price")
  // Custo unitário final já com frete/imposto/desconto rateados
  unitCost   Float    @default(0) @map("unit_cost")
  total      Float

  @@index([purchaseId])
  @@map("purchase_items")
}

// Contadores transacionais para códigos únicos (CLI-0001, FOR-0001, VDA-0001, ...)
model Sequence {
  key   String @id
  value Int    @default(0)

  @@map("sequences")
}

// ---------------------------------------------------------------------------
// Catálogo de serviços pré-definidos (Formatação, Limpeza, Montagem...)
// ---------------------------------------------------------------------------

model Service {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  price          Float
  category       String   @default("MAINTENANCE")
  estimatedHours Float    @default(1) @map("estimated_hours")
  // Briefing B8.2: checklist opcional do serviço (labels) - vira snapshot
  // no checklist da O.S. quando o serviço é usado
  checklist      Json?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  budgetItems BudgetItem[]
  osItems     OsItem[]

  @@index([category])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Financeiro: despesas e configurações
// ---------------------------------------------------------------------------

model Expense {
  id          String         @id @default(uuid())
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime       @default(now())
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([date])
  @@map("expenses")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("GENERAL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Licença DRM (offline, challenge-response RS256)
// ---------------------------------------------------------------------------

model License {
  id         String   @id @default(uuid())
  hardwareId String   @unique @map("hardware_id")
  // JWT RS256 original emitido pela Filitech (fonte da verdade da
  // assinatura). payload/signature são a cópia de conveniência/auditoria.
  token      String?  @db.Text
  payload    Json?
  signature  String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("licenses")
}

// ---------------------------------------------------------------------------
// Calendário / Agendamentos
// ---------------------------------------------------------------------------

model CalendarEvent {
  id          String            @id @default(uuid())
  title       String
  description String?
  type        CalendarEventType
  // Início/fim do evento (para feriados/dias especiais pode ser all-day)
  startAt     DateTime          @map("start_at")
  endAt       DateTime          @map("end_at")
  allDay      Boolean           @default(false) @map("all_day")
  // Cor no calendário (hex)
  color       String?
  // Recorrência (RRULE simplificado: daily, weekly, monthly, yearly)
  recurrence  String?
  // Técnico responsável (se for agendamento técnico)
  techId      String?           @map("tech_id")
  tech        User?             @relation("CalendarEventTechnician", fields: [techId], references: [id], onDelete: SetNull)
  // Link opcional para O.S. / ServiceVisit
  osId        String?           @map("os_id")
  visitId     String?           @map("visit_id")
  // Visibilidade: todos veem, mas pode restringir
  isPublic    Boolean           @default(true) @map("is_public")
  createdById String            @map("created_by_id")
  createdBy   User              @relation("CalendarEventCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([startAt, endAt])
  @@index([techId])
  @@index([type])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Venda de Produto (PDV Lite) - separada de O.S.
// ---------------------------------------------------------------------------

model Sale {
  id          String   @id @default(uuid())
  // Código único da venda (VDA-0001)
  code        String?  @unique
  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  // Tipo de venda: PRODUCT_ONLY (sem OS) ou FROM_OS (convertida de OS)
  saleType    String   @default("PRODUCT_ONLY") @map("sale_type")
  osId        String?  @map("os_id")
  total       Float    @default(0)
  discount    Float    @default(0)
  discountType String  @default("VALUE") @map("discount_type")
  paymentMethod String? @map("payment_method")
  // ESTADO do pagamento (PENDING|PAID|FAILED|CANCELLED|REFUNDED|PARTIAL).
  // `paymentMethod` é a FORMA escolhida no cadastro e NÃO serve para saber se
  // a venda foi paga — usar um como o outro quebrava a cobrança na maquininha.
  paymentStatus String  @default("PENDING") @map("payment_status")
  paidAt        DateTime? @map("paid_at")
  // Comprovante da transação aprovada na maquininha
  cardTransactionId     String? @map("card_transaction_id")
  cardAuthorizationCode String? @map("card_authorization_code")
  cardNsu               String? @map("card_nsu")
  cardBrand             String? @map("card_brand")
  cardInstallments      Int?    @map("card_installments")
  // PDF p.6: venda de mercadoria - campo de frete no documento
  freight     Float    @default(0)
  notes       String?
  // Briefing: endereço de ENTREGA (selecionar do cadastro ou digitado)
  deliveryAddress Json? @map("delivery_address")
  // Comissão total calculada no fechamento
  totalCommission Float  @default(0) @map("total_commission")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       SaleItem[]
  returns     SaleReturn[]
  cardTransactions CardTransaction[]

  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("sales")
}

/// Transação de cartão. Persistida para sobreviver a restart da API
/// (o serviço antigo só mantinha um Map em memória).
model CardTransaction {
  id                   String   @id
  saleId               String   @map("sale_id")
  sale                 Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  machineId            String   @map("machine_id")
  /// Driver que processou: CIELO | TEF_IP | SIMULATED
  gateway              String   @default("TEF_IP")
  /// PENDING | APPROVED | DECLINED | CANCELLED | ERROR
  status               String   @default("PENDING")
  /// SEMPRE em centavos
  amount               Int
  /// CREDIT | DEBIT | PIX
  type                 String
  installments         Int      @default(1)
  installmentsInterest String?  @map("installments_interest")
  cardBrand            String?  @map("card_brand")
  /// id da transação no gateway
  externalId           String?  @map("external_id")
  authorizationCode    String?  @map("authorization_code")
  nsu                  String?
  qrCode               String?  @map("qr_code")
  payload              Json?
  errorMessage         String?  @map("error_message")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([saleId])
  @@index([status])
  @@index([externalId])
  @@map("card_transactions")
}

// Briefing: devolução/troca gera um DOCUMENTO com observações
model SaleReturn {
  id          String   @id @default(uuid())
  code        String?  @unique
  saleId      String   @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // RETURN = devolução, EXCHANGE = troca
  type        String   @default("RETURN")
  reason      String?
  notes       String?
  total       Float    @default(0)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       SaleReturnItem[]

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id          String   @id @default(uuid())
  returnId    String   @map("return_id")
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId  String?  @map("sale_item_id")
  partId      String?  @map("part_id")
  part        Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  name        String
  qty         Int      @default(1)
  unitPrice   Float    @map("unit_price")
  total       Float    @default(0)

  @@index([returnId])
  @@map("sale_return_items")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  partId      String?  @map("part_id")
  part        Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  // Snapshot do item
  name        String
  code        String?
  qty         Int      @default(1)
  unitPrice   Float    @map("unit_price")
  // Comissão POR ITEM (Briefing: comissão personalizada por item)
  commissionPercent Float  @default(0) @map("commission_percent")
  commissionValue   Float  @default(0) @map("commission_value")
  // Qual comissão aplicar: PERCENT ou VALUE
  commissionType    String  @default("PERCENT") @map("commission_type")
  total       Float
  discount    Float     @default(0)
  discountType String   @default("VALUE") @map("discount_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([saleId])
  @@index([partId])
  @@map("sale_items")
}

