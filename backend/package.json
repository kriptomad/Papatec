{
  "name": "papatec-sistema-loja-backend",
  "version": "1.0.0",
  "description": "PapaTec - Sistema Loja - API segura com DRM offline (Filitech)",
  "private": true,
  "main": "dist/bundle.obfuscated.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit",
    "build:compile": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/bundle.js --packages=external --external:@prisma/client --external:@prisma/engines",
    "build:obfuscate": "javascript-obfuscator dist/bundle.js --output dist/bundle.obfuscated.js --compact true --control-flow-flattening true --control-flow-flattening-threshold 1 --dead-code-injection true --string-array true --string-array-encoding rc4 --string-array-threshold 0.75 --disable-console-output true --self-defending true",
    "build": "npm run build:compile && npm run build:obfuscate",
    "start": "node dist/bundle.obfuscated.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "keys": "ts-node --transpile-only generate-keys.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@types/express-rate-limit": "^5.1.3",
    "archiver": "^6.0.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "prisma": "^5.7.0",
    "unzipper": "^0.12.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "esbuild": "^0.19.11",
    "javascript-obfuscator": "^4.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
