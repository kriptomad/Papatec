# ============================================================
# PapaTec - Sistema Loja - Variaveis de Ambiente (modelo)
#
# NAO EDITE ESTE ARQUIVO. O instalador copia este modelo para `.env` e
# preenche os segredos sozinho:
#     Windows : INSTALAR.bat
#     Linux   : sudo ./instalar.sh
#
# Para so preparar a maquina (Docker + .env + pastas, sem compilar):
#     Windows : INSTALAR.bat preparar
#     Linux   : sudo ./instalar.sh --preparar
# ============================================================

# ---------------- Banco de dados (PostgreSQL) ----------------
# A senha e GERADA AUTOMATICAMENTE pelo instalador (64 caracteres).
DB_NAME=papatec
DB_USER=papatec
DB_PASSWORD=

# ---------------- Autenticacao (JWT) -------------------------
# JWT_SECRET tambem e gerado pelo instalador.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------- Licença / DRM (Filitech) ------------------
# Chave pública de validação fornecida pela FILITECH.
# NÃO altere: sem este valor o sistema bloqueia todas as rotas
# (403 SYSTEM_LOCKED_DRM_VIOLATION). Em caso de dúvida,
# solicite: licenca@filitech.com.br
LICENSE_PUBLIC_KEY_

# ---------------- Backups ------------------------------------
BACKUP_NETWORK_PATH=/backups
BACKUP_SCHEDULE=0 12,18 * * *

# ---------------- Uploads ------------------------------------
UPLOADS_PATH=/app/uploads

# ---------------- Identificacao da maquina (DRM) --------------
# Preenchido AUTOMATICAMENTE pelo instalador (UUID + MAC lidos no HOST).
# E o que o backend usa para gerar o Hardware ID (HWID) quando roda dentro
# do Docker - onde nao existem os comandos de hardware do host. Sem isso o
# HWID cairia no fallback e ficaria IGUAL em todas as maquinas.
# NAO apague depois: mudar estes valores invalida a licenca ativada aqui.
MACHINE_UUID=
MACHINE_MAC=

# ---------------- Maquininha de cartao ------------------------
# Segredo do POST /api/card-machines/callback.
# Gerado pelo instalador. VAZIO = callback DESLIGADO (ninguem consegue
# confirmar uma transacao) - que e o comportamento correto sem o valor.
CARD_MACHINE_CALLBACK_TOKEN=

# ---------------- DRM ----------------------------------------
# 'true' DESLIGA a validacao de licenca. Deixe como true enquanto a tabela
# `licenses` estiver vazia: com false o sistema inteiro responde 403.
DRM_BYPASS=true
